{
  "name": "UserPin",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome do operador"
    },
    "email": {
      "type": "string",
      "description": "E-mail do operador (opcional)"
    },
    "pin": {
      "type": "string",
      "description": "PIN de 4 d\u00edgitos para login r\u00e1pido"
    },
    "role": {
      "type": "string",
      "enum": [
        "operador",
        "supervisor",
        "administrador"
      ],
      "default": "operador",
      "description": "Fun\u00e7\u00e3o de acesso do operador (fallback quando n\u00e3o h\u00e1 perfil vinculado)"
    },
    "profile_id": {
      "type": "string",
      "description": "ID do perfil de acesso (UserRoleProfile) que define as abas permitidas"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "pin",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}