{
  "name": "UserPin",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome do operador"
    },
    "email": {
      "type": "string",
      "description": "E-mail do operador (opcional)"
    },
    "pin_hash": {
      "type": "string",
      "description": "Hash SHA-256 do PIN (formato: salt:pin) \u2014 o PIN leg\u00edvel nunca \u00e9 armazenado. Gerado e verificado exclusivamente no backend (fun\u00e7\u00e3o operatorPins)"
    },
    "pin_salt": {
      "type": "string",
      "description": "Salt aleat\u00f3rio por operador (hex, 16 bytes) usado no c\u00e1lculo do hash do PIN"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Tentativas incorretas consecutivas \u2014 controlado pelo backend para o bloqueio tempor\u00e1rio"
    },
    "locked_until": {
      "type": "string",
      "description": "Bloqueio tempor\u00e1rio do PIN ap\u00f3s 5 tentativas incorretas (timestamp ISO 8601). Zerado em login bem-sucedido ou redefini\u00e7\u00e3o de PIN"
    },
    "role": {
      "type": "string",
      "enum": [
        "operador",
        "supervisor",
        "administrador"
      ],
      "default": "operador",
      "description": "Fun\u00e7\u00e3o de acesso do operador (fallback quando n\u00e3o h\u00e1 perfil vinculado)"
    },
    "profile_id": {
      "type": "string",
      "description": "ID do perfil de acesso (UserRoleProfile) que define as abas permitidas"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}