{
  "name": "PrivacyPolicyNotice",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Vers\u00e3o do aviso de privacidade (ex: 1.0, 1.1)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "superseded"
      ],
      "default": "draft",
      "description": "Situa\u00e7\u00e3o da vers\u00e3o: draft (rascunho), published (vigente) ou superseded (substitu\u00edda \u2014 hist\u00f3rico imut\u00e1vel)"
    },
    "published_at": {
      "type": "string",
      "description": "Data/hora de publica\u00e7\u00e3o (ISO 8601) \u2014 null em rascunho"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vig\u00eancia do aviso"
    },
    "content": {
      "type": "object",
      "description": "Conte\u00fado do aviso: categorias de dados, finalidades, bases legais, reten\u00e7\u00e3o, fornecedores, contatos, controlador e encarregado. Campos n\u00e3o informados aparecem como PENDENTE.",
      "properties": {
        "controller": {
          "type": "string"
        },
        "dpo": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "legal_bases": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "retention": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "vendors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Chaves obrigat\u00f3rias para publica\u00e7\u00e3o \u2014 o aviso n\u00e3o pode ser publicado enquanto algum campo obrigat\u00f3rio estiver pendente"
    },
    "created_by": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) que criou a vers\u00e3o"
    }
  },
  "required": [
    "version",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}