{
  "name": "MachineDowntime",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID da m\u00e1quina"
    },
    "machine_name": {
      "type": "string",
      "description": "Nome da m\u00e1quina (cache)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da parada"
    },
    "start_time": {
      "type": "string",
      "description": "Hora de in\u00edcio da parada (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "Hora de fim da parada (HH:MM)"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "failure_category": {
      "type": "string",
      "enum": [
        "El\u00e9trico",
        "Mec\u00e2nico",
        "Pneum\u00e1tico",
        "Hidr\u00e1ulico",
        "Operacional",
        "Manuten\u00e7\u00e3o Preventiva",
        "Falta de Material",
        "Outros"
      ],
      "description": "Categoria da falha"
    },
    "failure_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da falha"
    },
    "corrective_action": {
      "type": "string",
      "description": "A\u00e7\u00e3o corretiva tomada"
    },
    "order_id": {
      "type": "string",
      "description": "ID da ordem de produ\u00e7\u00e3o vinculada (opcional)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00ba da ordem (cache)"
    },
    "recurrent_pattern_id": {
      "type": "string",
      "description": "ID do padr\u00e3o de falha recorrente (opcional)"
    }
  },
  "required": [
    "machine_id",
    "date",
    "failure_category",
    "duration_minutes"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    }
  }
}