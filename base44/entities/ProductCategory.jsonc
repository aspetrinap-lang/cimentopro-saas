{
  "name": "ProductCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria (ex: Blocos de Concreto)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    }
  }
}