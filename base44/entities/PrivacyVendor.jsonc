{
  "name": "PrivacyVendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do fornecedor (ex: Base44 SDK, hospedagem, provedor de e-mail, analytics)"
    },
    "category": {
      "type": "string",
      "enum": [
        "sdk",
        "hosting",
        "email",
        "analytics",
        "storage",
        "other"
      ],
      "description": "Categoria do fornecedor"
    },
    "purpose": {
      "type": "string",
      "description": "Finalidade do tratamento pelo fornecedor"
    },
    "dpa_signed": {
      "type": "boolean",
      "default": false,
      "description": "Indica se h\u00e1 contrato/DPA assinado \u2014 FALSE (pendente) por padr\u00e3o"
    },
    "subprocessors": {
      "type": "string",
      "description": "Subprocessadores declarados \u2014 A DEFINIR PELO CONTROLADOR por padr\u00e3o"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o do processamento (pa\u00eds/regi\u00e3o) \u2014 A DEFINIR PELO CONTROLADOR por padr\u00e3o"
    },
    "international_transfer": {
      "type": "string",
      "description": "Indica transfer\u00eancia internacional de dados \u2014 A DEFINIR PELO CONTROLADOR por padr\u00e3o"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}