{
  "name": "UserCompany",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio da plataforma (User)"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio (cache, exibi\u00e7\u00e3o)"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio (cache, exibi\u00e7\u00e3o)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company)"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa (cache, exibi\u00e7\u00e3o)"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "owner",
        "admin",
        "supervisor"
      ],
      "description": "Papel do usu\u00e1rio na empresa \u2014 member \u00e9 o v\u00ednculo simplificado da tela (acesso definido pelo perfil); owner/admin/supervisor para uso interno"
    },
    "profile_id": {
      "type": "string",
      "description": "ID do perfil de acesso (UserRoleProfile) vinculado \u2014 quando presente, RESTRINGE as permiss\u00f5es do papel (interse\u00e7\u00e3o); vazio = papel sem restri\u00e7\u00e3o"
    },
    "profile_name": {
      "type": "string",
      "description": "Nome do perfil de acesso (cache, exibi\u00e7\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invited",
        "inactive"
      ],
      "default": "active",
      "description": "Situa\u00e7\u00e3o do v\u00ednculo usu\u00e1rio-empresa"
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio \u00e9 o dono da empresa"
    }
  },
  "required": [
    "user_id",
    "company_id",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}