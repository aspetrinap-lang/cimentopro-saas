{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "ID do chamado (SupportTicket)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 espelhado do chamado para isolamento multi-tenant"
    },
    "sender_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) autor da mensagem"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome do autor (cache, exibi\u00e7\u00e3o)"
    },
    "sender_email": {
      "type": "string",
      "description": "E-mail do autor (cache, exibi\u00e7\u00e3o)"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "CUSTOMER",
        "SUPPORT",
        "SYSTEM",
        "AI"
      ],
      "description": "Tipo do autor: cliente, suporte, sistema ou IA (reservado para integra\u00e7\u00e3o futura)"
    },
    "message": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "is_internal": {
      "type": "boolean",
      "default": false,
      "description": "TRUE = nota interna do suporte \u2014 NUNCA vis\u00edvel ao cliente (filtrada no backend)"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "description": "Nome original do arquivo"
          },
          "file_uri": {
            "type": "string",
            "description": "URI do arquivo no armazenamento PRIVADO (URL assinada tempor\u00e1ria gerada no backend)"
          },
          "mime_type": {
            "type": "string",
            "description": "Tipo MIME do arquivo"
          },
          "file_size": {
            "type": "number",
            "description": "Tamanho do arquivo em bytes"
          }
        }
      },
      "description": "Anexos da mensagem \u2014 arquivos privados (png, jpg, jpeg, webp, pdf, xlsx, csv), URL de acesso sempre tempor\u00e1ria"
    }
  },
  "required": [
    "ticket_id",
    "sender_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}