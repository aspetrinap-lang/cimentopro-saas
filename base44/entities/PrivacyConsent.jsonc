{
  "name": "PrivacyConsent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do titular (User) que manifestou o consentimento"
    },
    "purpose": {
      "type": "string",
      "description": "Finalidade espec\u00edfica do tratamento consentida (sem consentimento gen\u00e9rico)"
    },
    "notice_version": {
      "type": "string",
      "description": "Vers\u00e3o do aviso de privacidade vigente no momento da manifesta\u00e7\u00e3o"
    },
    "granted_at": {
      "type": "string",
      "description": "Data/hora da manifesta\u00e7\u00e3o de consentimento (ISO 8601)"
    },
    "revoked_at": {
      "type": "string",
      "description": "Data/hora da revoga\u00e7\u00e3o (ISO 8601) \u2014 null enquanto vigente"
    },
    "revoked_reason": {
      "type": "string",
      "description": "Motivo da revoga\u00e7\u00e3o (quando aplic\u00e1vel)"
    }
  },
  "required": [
    "user_id",
    "purpose",
    "notice_version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}