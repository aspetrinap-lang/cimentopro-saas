{
  "name": "QualityReport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "report_number": {
      "type": "string",
      "description": "N\u00ba do laudo (sequencial)"
    },
    "order_id": {
      "type": "string",
      "description": "ID da ordem de produ\u00e7\u00e3o vinculada"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00ba da ordem (cache)"
    },
    "product_type_id": {
      "type": "string",
      "description": "ID do artefato"
    },
    "product_type_name": {
      "type": "string",
      "description": "Nome do artefato (cache)"
    },
    "category": {
      "type": "string",
      "description": "Categoria do artefato (Blocos/Pavimento)"
    },
    "norm_reference": {
      "type": "string",
      "enum": [
        "NBR 6136",
        "NBR 9781"
      ],
      "description": "Norma de refer\u00eancia (blocos ou pavimentos)"
    },
    "normative_revision": {
      "type": "string",
      "enum": [
        "2013",
        "2016",
        "2026"
      ],
      "default": "2026",
      "description": "Revis\u00e3o da norma aplicada no c\u00e1lculo de compress\u00e3o. Pavimentos: 2013 ou 2026 (NBR 9781). Blocos: 2016 ou 2026 (NBR 6136). Laudos sem este campo s\u00e3o tratados pela revis\u00e3o anterior (preserva\u00e7\u00e3o do hist\u00f3rico)."
    },
    "normative_standard": {
      "type": "string",
      "description": "Norma de m\u00e9todo de ensaio (ex: NBR 6136-2 para blocos, NBR 9781-2 para pavimentos)"
    },
    "normative_requirements": {
      "type": "string",
      "description": "Norma de requisitos (ex: NBR 6136-1 para blocos, NBR 9781-1 para pavimentos)"
    },
    "normative_version": {
      "type": "string",
      "description": "Vers\u00e3o da norma (ex: 2026, 2016, 2013)"
    },
    "engine_name": {
      "type": "string",
      "description": "Nome do motor de c\u00e1lculo utilizado (ex: NBR_9781_2026_COMPRESSION, blockCompressionEngine). Imut\u00e1vel ap\u00f3s a emiss\u00e3o."
    },
    "engine_version": {
      "type": "string",
      "description": "Vers\u00e3o do motor (ex: 1.0.0, v2026.1)"
    },
    "parameter_version": {
      "type": "string",
      "description": "Vers\u00e3o dos par\u00e2metros normativos (ex: NBR9781-COMPRESSION-2026, NBR6136-COMPRESSION-2026)"
    },
    "test_method_revision": {
      "type": "string",
      "description": "Revis\u00e3o do m\u00e9todo de ensaio (ex: NBR 9781-2:2026, NBR 6136-2:2026)"
    },
    "calculation_timestamp": {
      "type": "string",
      "description": "Data/hora do c\u00e1lculo (ISO 8601) \u2014 rastreabilidade"
    },
    "historical_engine_version": {
      "type": "string",
      "description": "Vers\u00e3o do motor hist\u00f3rico utilizado em laudos anteriores \u2014 nunca recalculado pelo motor vigente"
    },
    "historical_normative_version": {
      "type": "string",
      "description": "Vers\u00e3o normativa hist\u00f3rica do laudo \u2014 preservada para rastreabilidade"
    },
    "laboratory_name": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o do laborat\u00f3rio"
    },
    "test_equipment": {
      "type": "string",
      "description": "M\u00e1quina de ensaio utilizada (prensa)"
    },
    "calibration_number": {
      "type": "string",
      "description": "N\u00ba do certificado de calibra\u00e7\u00e3o da m\u00e1quina"
    },
    "calibration_date": {
      "type": "string",
      "format": "date",
      "description": "Data da calibra\u00e7\u00e3o da m\u00e1quina"
    },
    "calibration_issuer": {
      "type": "string",
      "description": "Emitente do certificado de calibra\u00e7\u00e3o"
    },
    "calibration_valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de validade do certificado de calibra\u00e7\u00e3o da prensa"
    },
    "press_id": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o da prensa utilizada no ensaio"
    },
    "press_serial": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie da prensa"
    },
    "equipment_accuracy_class": {
      "type": "string",
      "description": "Classe de acur\u00e1cia da prensa (ex: Classe 1, Classe 0.5)"
    },
    "responsible_engineer": {
      "type": "string",
      "description": "Engenheiro civil respons\u00e1vel"
    },
    "engineer_crea": {
      "type": "string",
      "description": "Registro CREA do respons\u00e1vel"
    },
    "manufacturer": {
      "type": "string",
      "description": "Fabricante do lote"
    },
    "application_location": {
      "type": "string",
      "description": "Local de aplica\u00e7\u00e3o do lote"
    },
    "molding_date": {
      "type": "string",
      "format": "date",
      "description": "Data de moldagem/recebimento"
    },
    "test_date": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio de ruptura (idade de refer\u00eancia)"
    },
    "specimen_count": {
      "type": "number",
      "default": 6,
      "description": "Quantidade de corpos de prova ensaiados"
    },
    "specimens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "age_days": {
            "type": "number"
          },
          "width_mm": {
            "type": "number"
          },
          "height_mm": {
            "type": "number"
          },
          "length_mm": {
            "type": "number"
          },
          "area_cm2": {
            "type": "number"
          },
          "mass_g": {
            "type": "number",
            "description": "Massa do corpo de prova (gramas)"
          },
          "rupture_load_kn": {
            "type": "number"
          },
          "resistance_mpa": {
            "type": "number"
          },
          "specimen_id": {
            "type": "string",
            "description": "Identifica\u00e7\u00e3o \u00fanica do corpo de prova (NBR 6136-2:2026)"
          },
          "sample_id": {
            "type": "string",
            "description": "Identifica\u00e7\u00e3o da amostra (prova/contraprova)"
          },
          "gross_area_mm2": {
            "type": "number",
            "description": "\u00c1rea bruta (mm\u00b2) \u2014 usada no c\u00e1lculo de fb (nunca a \u00e1rea l\u00edquida)"
          },
          "maximum_force_n": {
            "type": "number",
            "description": "For\u00e7a m\u00e1xima de ruptura (N)"
          },
          "individual_strength_mpa": {
            "type": "number",
            "description": "Resist\u00eancia individual fb = F/Ab (MPa)"
          },
          "failure_mode": {
            "type": "string",
            "description": "Modo de ruptura do corpo de prova"
          },
          "validity_status": {
            "type": "string",
            "enum": [
              "VALID",
              "INVALID"
            ],
            "description": "Situa\u00e7\u00e3o do corpo de prova"
          },
          "sample_role": {
            "type": "string",
            "enum": [
              "tracking",
              "proof",
              "counterproof"
            ],
            "description": "Papel do CP: tracking (acompanhamento por idade), proof (prova de aceita\u00e7\u00e3o), counterproof (contraprova)"
          }
        }
      },
      "description": "Resultados individuais dos corpos de prova (agrupados por idade: 7, 14, 21, 28 dias)"
    },
    "final_age_days": {
      "type": "number",
      "default": 28,
      "description": "Idade de refer\u00eancia para conformidade (28 dias)"
    },
    "average_resistance": {
      "type": "number",
      "description": "Resist\u00eancia m\u00e9dia (MPa) na idade de refer\u00eancia"
    },
    "min_resistance": {
      "type": "number",
      "description": "Menor resist\u00eancia individual (MPa) na idade de refer\u00eancia"
    },
    "estimated_fck": {
      "type": "number",
      "description": "Resist\u00eancia caracter\u00edstica estimada (fck est \u2014 MPa) \u2014 revis\u00e3o 2013"
    },
    "fpk_est": {
      "type": "number",
      "description": "Resist\u00eancia caracter\u00edstica estimada (fpk,est \u2014 MPa) \u2014 revis\u00e3o 2026"
    },
    "fpk": {
      "type": "number",
      "description": "Resist\u00eancia caracter\u00edstica final (fpk \u2014 MPa) \u2014 revis\u00e3o 2026"
    },
    "fbk_especificado_snapshot_mpa": {
      "type": "number",
      "description": "Snapshot imut\u00e1vel do fbk especificado (MPa) no momento da emiss\u00e3o do laudo \u2014 preserva a interpreta\u00e7\u00e3o hist\u00f3rica mesmo se o cadastro do produto mudar posteriormente. Nunca recalculado."
    },
    "psi_coefficient": {
      "type": "number",
      "description": "Coeficiente estat\u00edstico \u03c8 aplicado (revis\u00e3o 2026)"
    },
    "thickness_factor": {
      "type": "number",
      "description": "Fator de espessura (p) aplicado (revis\u00e3o 2026)"
    },
    "compression_method": {
      "type": "string",
      "description": "M\u00e9todo estat\u00edstico utilizado (small_sample | large_sample)"
    },
    "target_resistance": {
      "type": "number",
      "description": "Resist\u00eancia caracter\u00edstica de projeto (fck/fbk MPa)"
    },
    "traffic_type": {
      "type": "string",
      "enum": [
        "Pedestres/Leves",
        "Pesado"
      ],
      "description": "Tipo de tr\u00e1fego previsto (NBR 9781)"
    },
    "nominal_thickness_mm": {
      "type": "number",
      "description": "Espessura nominal (mm) \u2014 NBR 9781"
    },
    "measured_thickness_mm": {
      "type": "number",
      "description": "Espessura medida (mm) \u2014 NBR 9781"
    },
    "thickness_ok": {
      "type": "boolean",
      "description": "Conformidade dimensional da espessura (varia\u00e7\u00e3o \u2264 3 mm)"
    },
    "preparation_condition": {
      "type": "string",
      "description": "Condi\u00e7\u00e3o de prepara\u00e7\u00e3o do corpo de prova (ex: seco ao ar, imers\u00e3o, estufa)"
    },
    "humidity_relative_percent": {
      "type": "number",
      "description": "Umidade relativa (%) no momento do ensaio"
    },
    "humidity_validation_status": {
      "type": "string",
      "description": "Situa\u00e7\u00e3o da valida\u00e7\u00e3o de umidade (ex: DENTRO DO LIMITE, FORA DO LIMITE)"
    },
    "loading_rate_mpa_s": {
      "type": "number",
      "description": "Velocidade de carregamento informada pelo laborat\u00f3rio (MPa/s) \u2014 n\u00e3o alterada pelo sistema"
    },
    "loading_rate_min": {
      "type": "number",
      "description": "Limite m\u00ednimo da velocidade de carregamento normativa (MPa/s)"
    },
    "loading_rate_max": {
      "type": "number",
      "description": "Limite m\u00e1ximo da velocidade de carregamento normativa (MPa/s)"
    },
    "temperature_c": {
      "type": "number",
      "description": "Temperatura (\u00b0C) do procedimento de secagem/estufa, quando aplic\u00e1vel"
    },
    "exposure_time_hours": {
      "type": "number",
      "description": "Tempo de exposi\u00e7\u00e3o (horas) no procedimento de secagem/estufa, quando aplic\u00e1vel"
    },
    "post_oven_test_time_minutes": {
      "type": "number",
      "description": "Tempo (minutos) entre a retirada da estufa e o ensaio, quando aplic\u00e1vel"
    },
    "proof_result": {
      "type": "object",
      "description": "Resultado da prova de aceita\u00e7\u00e3o (6 CPs) \u2014 c\u00e1lculo independente, nunca misturado com a contraprova"
    },
    "counterproof_result": {
      "type": "object",
      "description": "Resultado da contraprova (6 CPs) \u2014 c\u00e1lculo independente, somente quando acionada pelo fluxo de aceita\u00e7\u00e3o"
    },
    "counterproof_state": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "AVAILABLE",
        "REQUIRED",
        "IN_PROGRESS",
        "COMPLETED"
      ],
      "default": "NOT_REQUIRED",
      "description": "Estado da contraprova no fluxo de aceita\u00e7\u00e3o do lote"
    },
    "final_lot_result": {
      "type": "string",
      "enum": [
        "CONFORME",
        "N\u00c3O CONFORME"
      ],
      "description": "Resultado final do lote (decis\u00e3o com base em prova/contraprova)"
    },
    "is_compliant": {
      "type": "boolean",
      "description": "Conformidade do lote frente \u00e0 norma (idade de refer\u00eancia)"
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alertas de n\u00e3o conformidade (informativos, n\u00e3o bloqueantes)"
    },
    "calculation_memory": {
      "type": "object",
      "description": "Mem\u00f3ria de c\u00e1lculo audit\u00e1vel \u2014 passos detalhados do motor de compress\u00e3o (rastreabilidade)"
    },
    "conclusion": {
      "type": "string",
      "description": "Conclus\u00e3o t\u00e9cnica do laudo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Emitido",
        "Revisado"
      ],
      "default": "Emitido",
      "description": "Situa\u00e7\u00e3o do laudo"
    }
  },
  "required": [
    "report_number",
    "order_id",
    "norm_reference",
    "molding_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}