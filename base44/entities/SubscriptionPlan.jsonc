{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plano (ex: Starter, Professional, Enterprise)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do plano (o que inclui, p\u00fablico-alvo)"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o mensal do plano (R$) \u2014 fonte \u00fanica, configur\u00e1vel pelo SUPER_ADMIN"
    },
    "annual_price": {
      "type": "number",
      "description": "Pre\u00e7o anual do plano (R$) \u2014 opcional; usado quando a assinatura tem ciclo anual (cobran\u00e7a manual)"
    },
    "max_users": {
      "type": "number",
      "description": "Limite de usu\u00e1rios permitidos no plano"
    },
    "max_machines": {
      "type": "number",
      "description": "Limite de m\u00e1quinas cadastradas no plano"
    },
    "max_production_lines": {
      "type": "number",
      "description": "Limite de linhas de produ\u00e7\u00e3o no plano"
    },
    "ai_analyses_per_month": {
      "type": "number",
      "description": "Limite mensal de an\u00e1lises IA por empresa. Ausente/null = ilimitado (compatibilidade com planos existentes); 0 = bloqueio expl\u00edcito; > 0 = limite mensal"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de funcionalidades inclu\u00eddas no plano (chaves, ex: QUALITY, COSTS, PRICING)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Situa\u00e7\u00e3o do plano (dispon\u00edvel ou n\u00e3o para novas assinaturas)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}