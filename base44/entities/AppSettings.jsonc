{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "key": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o (ex: insumo_names, insumo_costs, raw_materials, maintenance_intervals)"
    },
    "value": {
      "type": "object",
      "description": "Valor da configura\u00e7\u00e3o (objeto JSON)"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}