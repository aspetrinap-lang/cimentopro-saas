{
  "name": "DreAccount",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 c\u00f3pia independente da estrutura da DRE por empresa; nunca compartilhada entre empresas"
    },
    "template_id": {
      "type": "string",
      "description": "ID da conta de origem no DRE Padr\u00e3o CimentoPro (DreTemplateAccount) \u2014 apenas rastreabilidade da c\u00f3pia; altera\u00e7\u00f5es no template N\u00c3O propagam automaticamente"
    },
    "name": {
      "type": "string",
      "description": "Nome da conta na DRE da empresa (ex: Custos de Mat\u00e9ria Prima e Insumos)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta (texto livre da empresa)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Receita",
        "Custo Direto",
        "Custo Indireto Vari\u00e1vel",
        "Despesa Fixa",
        "Despesa Financeira"
      ],
      "description": "Categoria para rateio no custo do artefato (mesma estrutura da DRE atual)"
    },
    "apportionment_method": {
      "type": "string",
      "enum": [
        "none",
        "volume",
        "machine_hours"
      ],
      "default": "none",
      "description": "M\u00e9todo de rateio: none (n\u00e3o aloca no produto), volume (por pe\u00e7as/peso produzido), machine_hours (por horas de m\u00e1quina)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID da conta-m\u00e3e (DreAccount) \u2014 subcontas criadas pela pr\u00f3pria empresa"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o da conta na DRE da empresa"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "raw_material",
        "energy",
        "maintenance",
        "sales"
      ],
      "default": "manual",
      "description": "Origem dos valores da conta: manual (lan\u00e7amento/importa\u00e7\u00e3o) ou m\u00f3dulo alimentador do CimentoPro (mat\u00e9ria-prima, energia, manuten\u00e7\u00e3o, vendas)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Conta ativa \u2014 contas com hist\u00f3rico de lan\u00e7amentos s\u00e3o desativadas logicamente, nunca exclu\u00eddas fisicamente"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}