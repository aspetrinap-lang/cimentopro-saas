{
  "name": "DreAccount",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 c\u00f3pia independente da estrutura da DRE por empresa; nunca compartilhada entre empresas"
    },
    "template_id": {
      "type": "string",
      "description": "ID da conta de origem no DRE Padr\u00e3o CimentoPro (DreTemplateAccount) \u2014 apenas rastreabilidade da c\u00f3pia; altera\u00e7\u00f5es no template N\u00c3O propagam automaticamente"
    },
    "name": {
      "type": "string",
      "description": "Nome da conta na DRE da empresa (ex: Custos de Mat\u00e9ria Prima e Insumos)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta (texto livre da empresa)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Receita",
        "Custo Direto",
        "Custo Indireto Vari\u00e1vel",
        "Despesa Fixa",
        "Despesa Financeira"
      ],
      "description": "Categoria cont\u00e1bil da DRE (rateio legado \u2014 o motor v2 usa cost_component_type/rate_basis)"
    },
    "apportionment_method": {
      "type": "string",
      "enum": [
        "none",
        "volume",
        "machine_hours"
      ],
      "default": "none",
      "description": "M\u00e9todo de rateio legado (volume/horas) \u2014 o motor de custeio v2 usa rate_basis"
    },
    "cost_component_type": {
      "type": "string",
      "enum": [
        "material_direct",
        "mold",
        "energy",
        "direct_labor",
        "maintenance",
        "depreciation",
        "factory_overhead",
        "loss",
        "selling_expense",
        "tax",
        "commission",
        "freight",
        "financial",
        "other"
      ],
      "description": "Classifica\u00e7\u00e3o de custeio (motor v2): papel desta conta na forma\u00e7\u00e3o do custo industrial. Conta sem classifica\u00e7\u00e3o N\u00c3O entra no custo do produto at\u00e9 ser classificada na Estrutura da DRE"
    },
    "include_in_product_cost": {
      "type": "boolean",
      "default": false,
      "description": "Inclui a conta no custo industrial do produto. Considerada somente quando cost_component_type \u00e9 industrial e rate_basis n\u00e3o \u00e9 'none'"
    },
    "rate_basis": {
      "type": "string",
      "enum": [
        "kg",
        "unit",
        "machine_hours",
        "production_hours",
        "percentage",
        "none"
      ],
      "default": "none",
      "description": "Base de rateio da conta no custo do produto: kg (peso produzido), unit (pe\u00e7as produzidas), machine_hours/production_hours (horas), percentage (percentual dos demais custos industriais), none (n\u00e3o rateia)"
    },
    "cost_source": {
      "type": "string",
      "enum": [
        "dre",
        "module"
      ],
      "default": "dre",
      "description": "Origem do valor da conta no custeio: dre (valor financeiro da DRE) ou module (valor alimentado por m\u00f3dulo do CimentoPro \u2014 informativo, complementa source_type)"
    },
    "already_included_in_direct_material": {
      "type": "boolean",
      "default": false,
      "description": "Marca que o valor desta conta J\u00c1 est\u00e1 representado no custo operacional (tra\u00e7o/produ\u00e7\u00e3o/molde) \u2014 o motor v2 N\u00c3O soma novamente (evita dupla contabiliza\u00e7\u00e3o)"
    },
    "already_included_in_energy": {
      "type": "boolean",
      "default": false,
      "description": "Marca que o valor desta conta J\u00c1 est\u00e1 representado na energia operacional das linhas (kW \u00d7 h \u00d7 tarifa) \u2014 o motor v2 N\u00c3O soma novamente"
    },
    "break_even_classification": {
      "type": "string",
      "enum": [
        "revenue",
        "variable",
        "fixed_operational",
        "fixed_industrial",
        "fixed_cash",
        "fixed_non_cash",
        "financial_cash",
        "financial_non_cash",
        "excluded"
      ],
      "description": "Classifica\u00e7\u00e3o gerencial da conta no Ponto de Equil\u00edbrio v1.1: revenue (Faturamento Bruto), variable (dedu\u00e7\u00f5es e custos vari\u00e1veis \u2014 bloco distingue), fixed_operational (Gastos Fixos Operacionais \u2014 base do PEC/PEF/PEE), financial_cash (obriga\u00e7\u00f5es financeiras de caixa \u2014 PEF; papel investment fica fora do PEF). Valores legados (fixed_industrial/fixed_cash) s\u00e3o tratados como fixed_operational"
    },
    "break_even_block": {
      "type": "string",
      "enum": [
        "revenue",
        "revenue_deduction",
        "variable_costs",
        "factory",
        "personnel",
        "structure",
        "financial_obligations",
        "investment"
      ],
      "description": "Bloco gerencial da conta na composi\u00e7\u00e3o audit\u00e1vel do Ponto de Equil\u00edbrio: Dedu\u00e7\u00f5es da Receita, Custos Vari\u00e1veis, F\u00e1brica, Pessoal, Estrutura, Obriga\u00e7\u00f5es N\u00e3o Operacionais de Caixa, Investimentos"
    },
    "financial_role": {
      "type": "string",
      "enum": [
        "interest",
        "iof",
        "amortization",
        "investment",
        "financial_other"
      ],
      "description": "Papel financeiro da conta (somente financial_cash): interest (juros), iof, amortization (amortiza\u00e7\u00f5es \u2014 entram no PEF), investment (investimentos \u2014 NUNCA entram automaticamente no PEF operacional), financial_other"
    },
    "break_even_role": {
      "type": "string",
      "enum": [
        "revenue",
        "variable",
        "operational",
        "financial"
      ],
      "description": "Papel gerencial da conta no Ponto de Equil\u00edbrio (auditoria): revenue, variable, operational, financial"
    },
    "enabled_for_pec": {
      "type": "boolean",
      "default": false,
      "description": "A conta participa do PEC (s\u00f3 contas fixed_operational)"
    },
    "enabled_for_pef": {
      "type": "boolean",
      "default": false,
      "description": "A conta participa do PEF \u2014 financial_cash com papel interest/iof/amortization/financial_other; investimentos ficam FORA por padr\u00e3o (configura\u00e7\u00e3o expl\u00edcita necess\u00e1ria)"
    },
    "enabled_for_pee": {
      "type": "boolean",
      "default": false,
      "description": "A conta participa do PEE \u2014 apenas fixed_operational (o lucro m\u00ednimo desejado \u00e9 par\u00e2metro, n\u00e3o conta)"
    },
    "cash_effect": {
      "type": "string",
      "enum": [
        "cash_in",
        "cash_out",
        "non_cash",
        "none"
      ],
      "default": "none",
      "description": "Efeito da conta no caixa (auditoria dos desembolsos): cash_in (entrada/recebimento), cash_out (sa\u00edda/desembolso), non_cash (sem desembolso imediato \u2014 deprecia\u00e7\u00e3o, amortiza\u00e7\u00e3o, provis\u00f5es), none (sem efeito definido)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID da conta-m\u00e3e (DreAccount) \u2014 subcontas criadas pela pr\u00f3pria empresa"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o da conta na DRE da empresa"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "raw_material",
        "energy",
        "maintenance",
        "sales"
      ],
      "default": "manual",
      "description": "Origem dos valores da conta para a automa\u00e7\u00e3o (sync_period): manual (lan\u00e7amento/importa\u00e7\u00e3o) ou m\u00f3dulo alimentador do CimentoPro"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Conta ativa \u2014 contas com hist\u00f3rico de lan\u00e7amentos s\u00e3o desativadas logicamente, nunca exclu\u00eddas fisicamente"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}