{
  "name": "DataInventory",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "Nome da entidade mapeada (ex: User, UserPin, UserCompany, AuditLog, ProductionOrder, QualityReport)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o dos dados pessoais contidos na entidade"
    },
    "data_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias de dados pessoais (identifica\u00e7\u00e3o, contato, operacionais, financeiros, etc.)"
    },
    "retention_period_days": {
      "type": "number",
      "description": "Prazo de reten\u00e7\u00e3o em dias \u2014 null = A DEFINIR PELO CONTROLADOR (pendente)"
    },
    "retention_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Flag de ativa\u00e7\u00e3o da reten\u00e7\u00e3o/descarte: FALSE por padr\u00e3o \u2014 nenhuma rotina descarta ou anonimiza dados enquanto o controlador n\u00e3o aprovar prazos e exce\u00e7\u00f5es"
    },
    "protected": {
      "type": "boolean",
      "default": false,
      "description": "Registros protegidos n\u00e3o s\u00e3o descart\u00e1veis (ex: obriga\u00e7\u00f5es legais, fiscais, contratuais)"
    },
    "disposal_method": {
      "type": "string",
      "description": "M\u00e9todo de descarte/anonimiza\u00e7\u00e3o (quando aplic\u00e1vel) \u2014 A DEFINIR PELO CONTROLADOR por padr\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "entity_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}