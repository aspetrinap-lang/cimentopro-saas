{
  "name": "SupportNotification",
  "type": "object",
  "properties": {
    "recipient_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) destinat\u00e1rio \u2014 v\u00ea somente as pr\u00f3prias notifica\u00e7\u00f5es"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID do chamado relacionado (SupportTicket)"
    },
    "ticket_number": {
      "type": "number",
      "description": "N\u00famero do chamado (cache, exibi\u00e7\u00e3o)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) do chamado (cache, exibi\u00e7\u00e3o)"
    },
    "type": {
      "type": "string",
      "enum": [
        "NEW_TICKET",
        "NEW_MESSAGE",
        "STATUS_CHANGED",
        "ASSIGNED",
        "RESOLVED",
        "SATISFACTION"
      ],
      "description": "Tipo de evento da notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o (ex: Novo chamado #000124)"
    },
    "body": {
      "type": "string",
      "description": "Resumo do evento"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o destinat\u00e1rio j\u00e1 leu a notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "recipient_user_id",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "data.recipient_user_id": "{{user.id}}"
    },
    "update": {
      "data.recipient_user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}