{
  "name": "UserRoleProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do perfil de acesso (ex: Operador de Produ\u00e7\u00e3o, Supervisor de Qualidade)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do que este perfil pode acessar"
    },
    "permissions": {
      "type": "object",
      "description": "Permiss\u00f5es granulares por m\u00f3dulo (chave \u2192 true). Formato atual: PRODUCTION_VIEW, PRODUCTION_CREATE, PRODUCTION_EDIT, PRODUCTION_DELETE, MACHINES_VIEW, MACHINES_CREATE, MACHINES_EDIT, MACHINES_DELETE, MAINTENANCE_VIEW, MAINTENANCE_EDIT, QUALITY_VIEW, QUALITY_EDIT, COSTS_VIEW, COSTS_EDIT, INDICATORS_VIEW, SETTINGS_VIEW, SETTINGS_MANAGE. O formato legado (booleans por m\u00f3dulo: orders, machines, ...) ainda \u00e9 aceito e convertido automaticamente para o granular.",
      "default": {
        "PRODUCTION_VIEW": true
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}