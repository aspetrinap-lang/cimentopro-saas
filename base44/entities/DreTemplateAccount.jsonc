{
  "name": "DreTemplateAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da conta no DRE Padr\u00e3o CimentoPro (ex: Receitas Operacionais, Custos de Mat\u00e9ria Prima e Insumos)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta do template (organiza\u00e7\u00e3o, grupo, regra)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Receita",
        "Custo Direto",
        "Custo Indireto Vari\u00e1vel",
        "Despesa Fixa",
        "Despesa Financeira"
      ],
      "description": "Categoria para rateio no custo do artefato (mesma estrutura da DRE atual)"
    },
    "apportionment_method": {
      "type": "string",
      "enum": [
        "none",
        "volume",
        "machine_hours"
      ],
      "default": "none",
      "description": "M\u00e9todo de rateio: none (n\u00e3o aloca no produto), volume (por pe\u00e7as/peso produzido), machine_hours (por horas de m\u00e1quina)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID da conta-m\u00e3e no template (subcontas \u2014 agrupamento estrutural)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o da conta no template"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Conta ativa no template \u2014 somente contas ativas s\u00e3o copiadas para as empresas"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "is_platform_admin": true
      }
    },
    "create": {
      "user_condition": {
        "is_platform_admin": true
      }
    },
    "update": {
      "user_condition": {
        "is_platform_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "is_platform_admin": true
      }
    }
  }
}