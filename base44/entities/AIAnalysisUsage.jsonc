{
  "name": "AIAnalysisUsage",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 o consumo de IA \u00e9 contabilizado e limitado por empresa e m\u00eas calend\u00e1rio"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) que executou a an\u00e1lise"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "order_analysis",
        "quality_analysis",
        "virtual_engineer"
      ],
      "description": "Tipo de an\u00e1lise IA executada"
    },
    "model": {
      "type": "string",
      "description": "Modelo utilizado (ex: automatic)"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "error"
      ],
      "default": "completed",
      "description": "Situa\u00e7\u00e3o da execu\u00e7\u00e3o \u2014 registro gravado apenas quando a IA realmente executou"
    },
    "tokens": {
      "type": "number",
      "description": "Total de tokens (preenchido apenas quando a plataforma fornecer; permanece nulo caso contr\u00e1rio)"
    },
    "input_tokens": {
      "type": "number",
      "description": "Tokens de entrada (preenchido apenas quando a plataforma fornecer; permanece nulo caso contr\u00e1rio)"
    },
    "output_tokens": {
      "type": "number",
      "description": "Tokens de sa\u00edda (preenchido apenas quando a plataforma fornecer; permanece nulo caso contr\u00e1rio)"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Custo estimado da execu\u00e7\u00e3o (nunca inventado \u2014 permanece nulo sem informa\u00e7\u00e3o real da plataforma)"
    }
  },
  "required": [
    "company_id",
    "user_id",
    "analysis_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}