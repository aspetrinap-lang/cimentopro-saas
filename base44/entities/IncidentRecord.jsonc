{
  "name": "IncidentRecord",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do incidente de seguran\u00e7a"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do incidente (detec\u00e7\u00e3o, impacto, dados afetados)"
    },
    "status": {
      "type": "string",
      "enum": [
        "detectado",
        "contido",
        "em_avaliacao",
        "resolvido"
      ],
      "default": "detectado",
      "description": "Situa\u00e7\u00e3o do incidente no fluxo operacional"
    },
    "detected_at": {
      "type": "string",
      "description": "Data/hora de detec\u00e7\u00e3o (ISO 8601)"
    },
    "contained_at": {
      "type": "string",
      "description": "Data/hora de conten\u00e7\u00e3o (ISO 8601)"
    },
    "actions": {
      "type": "array",
      "description": "A\u00e7\u00f5es tomadas (conten\u00e7\u00e3o, preserva\u00e7\u00e3o de evid\u00eancias, avalia\u00e7\u00e3o)",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "description": "Comunica\u00e7\u00e3o do incidente (controlador, titulares, ANPD) \u2014 registrada quando aplic\u00e1vel. Nenhuma notifica\u00e7\u00e3o real ou envio de dados a terceiros nesta implementa\u00e7\u00e3o.",
      "properties": {
        "controller_notified": {
          "type": "boolean"
        },
        "subjects_notified": {
          "type": "boolean"
        },
        "anpd_notified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__apenas_backend__"
      }
    }
  }
}