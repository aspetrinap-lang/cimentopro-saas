{
  "name": "AIAnalysis",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 isolamento multi-tenant; nenhuma an\u00e1lise \u00e9 compartilhada ou usada como cache entre empresas"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) que solicitou a an\u00e1lise"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "order_analysis",
        "quality_analysis",
        "virtual_engineer"
      ],
      "description": "Tipo de an\u00e1lise IA executada"
    },
    "period_start": {
      "type": "string",
      "description": "In\u00edcio do per\u00edodo analisado (YYYY-MM-DD)"
    },
    "period_end": {
      "type": "string",
      "description": "Fim do per\u00edodo analisado (YYYY-MM-DD)"
    },
    "data_fingerprint": {
      "type": "string",
      "description": "Hash SHA-256 dos dados determin\u00edsticos de entrada \u2014 base do cache (sem expira\u00e7\u00e3o por tempo); mudou = nova an\u00e1lise pode ser executada"
    },
    "input_summary": {
      "type": "string",
      "description": "Resumo determin\u00edstico enviado \u00e0 IA (truncado, rastreabilidade dos dados interpretados)"
    },
    "result": {
      "type": "object",
      "description": "Resultado estruturado da an\u00e1lise IA (achados com evidence_type, confidence, evidence)"
    },
    "model": {
      "type": "string",
      "description": "Modelo utilizado (ex: automatic)"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "error"
      ],
      "default": "completed",
      "description": "Situa\u00e7\u00e3o da an\u00e1lise"
    }
  },
  "required": [
    "company_id",
    "user_id",
    "analysis_type",
    "data_fingerprint",
    "result"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}