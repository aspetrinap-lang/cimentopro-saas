{
  "name": "MonthlyDre",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o/importa\u00e7\u00e3o"
    },
    "reference_month": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM (ex: 2026-08)"
    },
    "month_label": {
      "type": "string",
      "description": "R\u00f3tulo leg\u00edvel do m\u00eas (ex: Agosto/2026)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_name": {
            "type": "string",
            "description": "Nome da conta da DRE (ex: Receita Bruta de Vendas)"
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta na estrutura da empresa (DreAccount) \u2014 v\u00ednculo do lan\u00e7amento com a configura\u00e7\u00e3o da DRE da empresa"
          },
          "planned_value": {
            "type": "number",
            "description": "Valor or\u00e7ado (R$)"
          },
          "actual_value": {
            "type": "number",
            "description": "Valor realizado (R$)"
          },
          "category": {
            "type": "string",
            "enum": [
              "Receita",
              "Custo Direto",
              "Custo Indireto Vari\u00e1vel",
              "Despesa Fixa",
              "Despesa Financeira"
            ],
            "description": "Categoria para rateio no custo do artefato"
          },
          "apportionment_method": {
            "type": "string",
            "enum": [
              "none",
              "volume",
              "machine_hours"
            ],
            "description": "M\u00e9todo de rateio: none (n\u00e3o aloca no produto), volume (por pe\u00e7as produzidas), machine_hours (por horas de m\u00e1quina)"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "manual",
              "raw_material",
              "energy",
              "maintenance",
              "sales"
            ],
            "default": "manual",
            "description": "Origem do lan\u00e7amento: manual (digita\u00e7\u00e3o/importa\u00e7\u00e3o Excel) ou m\u00f3dulo alimentador do CimentoPro (mat\u00e9ria-prima, energia, manuten\u00e7\u00e3o, vendas)"
          },
          "automatic": {
            "type": "boolean",
            "default": false,
            "description": "TRUE quando o valor foi gerado automaticamente pelos m\u00f3dulos do CimentoPro; FALSE para lan\u00e7amento manual/importado"
          }
        }
      },
      "description": "Linhas detalhadas da DRE importadas para o m\u00eas (subtotais exclu\u00eddos)"
    },
    "faturamento_account": {
      "type": "string",
      "description": "Nome da conta usada como faturamento (ex: Receitas Operacionais)"
    },
    "faturamento_planned": {
      "type": "number",
      "description": "Faturamento or\u00e7ado (R$) \u2014 lido da linha Receitas Operacionais"
    },
    "faturamento_actual": {
      "type": "number",
      "description": "Faturamento realizado (R$) \u2014 lido da linha Receitas Operacionais, sem somar subitens"
    },
    "total_planned": {
      "type": "number",
      "description": "Soma dos valores or\u00e7ados das linhas detalhadas (cache)"
    },
    "total_actual": {
      "type": "number",
      "description": "Soma dos valores realizados das linhas detalhadas (cache)"
    },
    "total_apportionable": {
      "type": "number",
      "description": "Soma dos valores realizados que s\u00e3o rate\u00e1veis no custo do artefato (exclui Receita e Despesa Financeira) (cache)"
    },
    "total_receita_planned": {
      "type": "number",
      "description": "Soma dos valores or\u00e7ados das contas de Receita (cache)"
    },
    "total_receita_actual": {
      "type": "number",
      "description": "Soma dos valores realizados das contas de Receita (cache)"
    },
    "total_despesa_planned": {
      "type": "number",
      "description": "Soma dos valores or\u00e7ados das contas que n\u00e3o s\u00e3o Receita (cache)"
    },
    "total_despesa_actual": {
      "type": "number",
      "description": "Soma dos valores realizados das contas que n\u00e3o s\u00e3o Receita (cache)"
    },
    "closed": {
      "type": "boolean",
      "default": false,
      "description": "Fechamento mensal: per\u00edodo fechado preserva os valores \u2014 altera\u00e7\u00f5es posteriores entram como ajustes, sem rec\u00e1lculo autom\u00e1tico"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da importa\u00e7\u00e3o"
    }
  },
  "required": [
    "reference_month",
    "month_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}