{
  "name": "StrengthPrediction",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant; nenhuma previs\u00e3o \u00e9 compartilhada entre empresas"
    },
    "product_id": {
      "type": "string",
      "description": "ID do artefato (ProductType) alvo da previs\u00e3o"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do artefato (cache, exibi\u00e7\u00e3o)"
    },
    "trace_id": {
      "type": "string",
      "description": "ID do tra\u00e7o (ConcreteTrace) usado na segmenta\u00e7\u00e3o da previs\u00e3o"
    },
    "trace_name": {
      "type": "string",
      "description": "Nome do tra\u00e7o (cache, exibi\u00e7\u00e3o)"
    },
    "prediction_date": {
      "type": "string",
      "description": "Data/hora da gera\u00e7\u00e3o da previs\u00e3o (ISO 8601) \u2014 preservada, nunca alterada"
    },
    "target_age_days": {
      "type": "number",
      "description": "Idade alvo da previs\u00e3o (dias)"
    },
    "predicted_strength": {
      "type": "number",
      "description": "Resist\u00eancia projetada (MPa) \u2014 valor central do modelo"
    },
    "lower_bound": {
      "type": "number",
      "description": "Limite inferior do intervalo de incerteza (MPa)"
    },
    "upper_bound": {
      "type": "number",
      "description": "Limite superior do intervalo de incerteza (MPa)"
    },
    "model_version": {
      "type": "string",
      "description": "Vers\u00e3o do motor (resistanceCurveEngine vX) \u2014 imut\u00e1vel ap\u00f3s a cria\u00e7\u00e3o"
    },
    "model_method": {
      "type": "string",
      "description": "M\u00e9todo do modelo (ratios | curve_fit | reference_fallback)"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "ALTA",
        "M\u00c9DIA",
        "BAIXA"
      ],
      "description": "Confian\u00e7a da proje\u00e7\u00e3o no momento da gera\u00e7\u00e3o"
    },
    "actual_strength": {
      "type": "number",
      "description": "Resist\u00eancia real medida em laudo posterior (MPa) \u2014 preenchida apenas na valida\u00e7\u00e3o"
    },
    "prediction_error": {
      "type": "number",
      "description": "Erro da previs\u00e3o: REAL \u2212 IA (MPa) \u2014 preserva a previs\u00e3o original, nunca a sobrescreve"
    },
    "prediction_error_pct": {
      "type": "number",
      "description": "Erro percentual: ((REAL \u2212 IA) / IA) \u00d7 100"
    },
    "validated_at": {
      "type": "string",
      "description": "Data/hora da valida\u00e7\u00e3o contra resultado real (ISO 8601)"
    }
  },
  "required": [
    "company_id",
    "product_id",
    "target_age_days",
    "predicted_strength"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}