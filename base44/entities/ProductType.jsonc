{
  "name": "ProductType",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome do artefato (ex: Bloco 14)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo interno do produto"
    },
    "category": {
      "type": "string",
      "description": "Subcategoria do artefato (ex: Blocos de Concreto)"
    },
    "unit": {
      "type": "string",
      "default": "un",
      "description": "Unidade de medida"
    },
    "units_per_mold": {
      "type": "number",
      "description": "Quantidade de artefatos por molde"
    },
    "length_mm": {
      "type": "number",
      "description": "Comprimento (mm)"
    },
    "width_mm": {
      "type": "number",
      "description": "Largura (mm)"
    },
    "height_mm": {
      "type": "number",
      "description": "Altura (mm)"
    },
    "pieces_per_m": {
      "type": "number",
      "description": "Quantidade de pe\u00e7as por metro"
    },
    "pieces_per_m_unit": {
      "type": "string",
      "enum": [
        "m",
        "m2"
      ],
      "default": "m",
      "description": "Unidade de medida para pe\u00e7as por metro (m linear ou m\u00b2)"
    },
    "mold_id": {
      "type": "string",
      "description": "ID do molde vinculado para produ\u00e7\u00e3o"
    },
    "mold_name": {
      "type": "string",
      "description": "Nome do molde (cache)"
    },
    "mold_cost_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Custo do molde por unidade (R$) = custo_molde / vida_util_ciclos / pe\u00e7as_por_ciclo"
    },
    "concrete_trace_id": {
      "type": "string",
      "description": "ID do tra\u00e7o de concreto vinculado"
    },
    "volume_per_unit_m3": {
      "type": "number",
      "description": "CAMPO LEGADO \u2014 historicamente armazenou o peso da pe\u00e7a (kg). Mantido para compatibilidade: o motor v2 usa weight_kg_per_unit e recorre a este valor apenas como fallback provis\u00f3rio (marcado como estimado)"
    },
    "weight_kg_per_unit": {
      "type": "number",
      "description": "Peso real por pe\u00e7a (kg) \u2014 base do custeio v2 (rateio por kg e custo de energia por peso)"
    },
    "volume_m3_per_unit": {
      "type": "number",
      "description": "Volume geom\u00e9trico por pe\u00e7a (m\u00b3) \u2014 distinto do peso; nunca assumir volume = peso"
    },
    "cement_per_unit": {
      "type": "number",
      "description": "Cimento por unidade (kg)"
    },
    "sand_artificial_per_unit": {
      "type": "number",
      "description": "Areia Artificial por unidade (kg)"
    },
    "sand_medium_per_unit": {
      "type": "number",
      "description": "Areia M\u00e9dia por unidade (kg)"
    },
    "sand_fine_per_unit": {
      "type": "number",
      "description": "Areia Fina por unidade (kg)"
    },
    "gravel_per_unit": {
      "type": "number",
      "description": "Brita por unidade (kg)"
    },
    "additive_per_unit": {
      "type": "number",
      "description": "Aditivo por unidade (kg)"
    },
    "pigment_per_unit": {
      "type": "number",
      "description": "Pigmento por unidade (kg)"
    },
    "water_per_unit": {
      "type": "number",
      "description": "\u00c1gua por unidade (L)"
    },
    "norm_class": {
      "type": "string",
      "description": "Classe da norma aplic\u00e1vel (NBR 6136: A/B/C; NBR 9781: 35/50)"
    },
    "target_resistance": {
      "type": "number",
      "default": 0,
      "description": "Resist\u00eancia caracter\u00edstica de projeto (fck/fbk MPa) \u2014 preenchido pela classe da norma"
    },
    "selling_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o de venda por unidade (R$) \u2014 usado para c\u00e1lculo de margem de lucro"
    },
    "tax_rate_percent": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota tribut\u00e1ria efetiva do produto (%) \u2014 exce\u00e7\u00e3o por produto; quando > 0 sobrep\u00f5e a al\u00edquota padr\u00e3o da empresa no motor v2"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}