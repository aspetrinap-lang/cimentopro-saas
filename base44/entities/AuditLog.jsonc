{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou a a\u00e7\u00e3o"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio (cache, exibi\u00e7\u00e3o)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa afetada / escopo da a\u00e7\u00e3o"
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "DELETE",
        "LOGIN",
        "LOGOUT",
        "PERMISSION_CHANGE",
        "COMPANY_STATUS_CHANGE"
      ],
      "description": "A\u00e7\u00e3o registrada na auditoria"
    },
    "entity_name": {
      "type": "string",
      "description": "Entidade afetada (ex: ProductionOrder, UserPin, Company, UserRoleProfile)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "old_value": {
      "type": "object",
      "description": "Estado anterior (sanitizado \u2014 sem senhas, tokens, credenciais ou dados sens\u00edveis)"
    },
    "new_value": {
      "type": "object",
      "description": "Estado novo (sanitizado \u2014 sem senhas, tokens, credenciais ou dados sens\u00edveis)"
    },
    "ip": {
      "type": "string",
      "description": "IP de origem da requisi\u00e7\u00e3o (quando dispon\u00edvel)"
    }
  },
  "required": [
    "user_id",
    "action",
    "entity_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}