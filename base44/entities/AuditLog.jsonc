{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (SUPER_ADMIN) que realizou a a\u00e7\u00e3o"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio (cache)"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa afetada, quando aplic\u00e1vel"
    },
    "action": {
      "type": "string",
      "enum": [
        "COMPANY_CREATED",
        "COMPANY_UPDATED",
        "COMPANY_SUSPENDED",
        "COMPANY_REACTIVATED",
        "COMPANY_CANCELLED",
        "USER_CREATED",
        "USER_DEACTIVATED",
        "PLAN_CHANGED",
        "SUBSCRIPTION_CHANGED",
        "PLATFORM_SETTING_CHANGED"
      ],
      "description": "A\u00e7\u00e3o administrativa realizada"
    },
    "resource": {
      "type": "string",
      "description": "Tipo de recurso afetado (ex: company, user, plan)"
    },
    "resource_id": {
      "type": "string",
      "description": "ID do recurso afetado"
    },
    "ip": {
      "type": "string",
      "description": "IP de origem da requisi\u00e7\u00e3o"
    },
    "metadata": {
      "type": "object",
      "description": "Dados adicionais da a\u00e7\u00e3o (ex: campos alterados, status)"
    }
  },
  "required": [
    "user_id",
    "action",
    "resource"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}