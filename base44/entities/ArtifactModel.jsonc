{
  "name": "ArtifactModel",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 escopo multi-tenant, definido pela empresa ativa na cria\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome do modelo (ex: Bloco Estrutural 14x19x39)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo interno do modelo"
    },
    "category": {
      "type": "string",
      "description": "Subcategoria (ex: Blocos de Concreto, Pavimento de Concreto, Meio fio)"
    },
    "length_mm": {
      "type": "number",
      "description": "Comprimento (mm)"
    },
    "width_mm": {
      "type": "number",
      "description": "Largura (mm)"
    },
    "height_mm": {
      "type": "number",
      "description": "Altura (mm)"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso por unidade (kg)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o t\u00e9cnica do modelo"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}