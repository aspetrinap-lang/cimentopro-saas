{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa (Company) \u2014 assinatura \u00e9 por empresa"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa (cache, exibi\u00e7\u00e3o)"
    },
    "plan_id": {
      "type": "string",
      "description": "ID do plano (SubscriptionPlan) \u2014 vazio no trial autom\u00e1tico (acesso integral durante o trial)"
    },
    "plan_name": {
      "type": "string",
      "description": "Nome do plano (cache, exibi\u00e7\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "suspended",
        "cancelled"
      ],
      "default": "trial",
      "description": "Situa\u00e7\u00e3o da assinatura"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "description": "Ciclo de cobran\u00e7a (manual): mensal (end_date = in\u00edcio + 30 dias) ou anual (end_date = in\u00edcio + 365 dias)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da assinatura"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino (vencimento) da assinatura \u2014 calculada pelo ciclo quando n\u00e3o informada manualmente"
    }
  },
  "required": [
    "company_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": {
            "$in": "{{user.data.company_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    }
  }
}